<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dao.BisaiguanliDao">

    <resultMap type="com.entity.BisaiguanliEntity" id="bisaiguanliMap">
                    <result property="id"    column="id"    />
                    <result property="addtime"    column="addtime"    />
                    <result property="changdimingcheng"    column="changdimingcheng"    />
                    <result property="changditupian"    column="changditupian"    />
                    <result property="changdidaxiao"    column="changdidaxiao"    />
                    <result property="changdirenshu"    column="changdirenshu"    />
                    <result property="xiangqing"    column="xiangqing"    />
                    <result property="bisaishijian"    column="bisaishijian"    />
            </resultMap>

    <select id="selectListVO"
            resultType="com.entity.vo.BisaiguanliVO">
        SELECT * FROM bisaiguanli bisaiguanli
        <where> 1=1 ${ew.sqlSegment}</where>
    </select>

    <select id="selectVO"
            resultType="com.entity.vo.BisaiguanliVO">
        SELECT bisaiguanli.* FROM bisaiguanli bisaiguanli
        <where> 1=1 ${ew.sqlSegment}</where>
    </select>

    <select id="selectListView"
            resultType="com.entity.view.BisaiguanliView">

        SELECT bisaiguanli.* FROM bisaiguanli bisaiguanli
        <where> 1=1 ${ew.sqlSegment}</where>
    </select>

    <select id="selectView"
            resultType="com.entity.view.BisaiguanliView">
        SELECT * FROM bisaiguanli bisaiguanli
        <where> 1=1 ${ew.sqlSegment}</where>
    </select>

</mapper>